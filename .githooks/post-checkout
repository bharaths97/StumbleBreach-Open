#!/bin/sh
# Git cannot block a checkout before it happens. Warn immediately when the
# shared one-folder workspace still contains engagement/recon leftovers.
if [ "$3" = "1" ] && [ -f scripts/engagement_guard.py ]; then
  python3 scripts/engagement_guard.py hygiene >/dev/null 2>&1 ||
    printf '%s\n' 'engagement guard: workspace hygiene needs review; run python3 scripts/engagement_guard.py hygiene' >&2
fi
