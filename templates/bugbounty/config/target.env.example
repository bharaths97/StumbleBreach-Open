# Copy this file to target.env and fill in real values.
# target.env is gitignored — don't commit real target details.

TARGET_HOST=
TARGET_PORT=
TARGET_URL=
TARGET_VERSION=

# Comma-separated list of exact target strings the hub_guard MCP scope
# check will match against (IPs, URLs, hostnames) — e.g.
# IN_SCOPE_TARGETS=192.0.2.10,https://example.invalid,example.test
IN_SCOPE_TARGETS=

# Coarse routing: leave empty for legacy web-only engagements, or use
# web, blockchain, or web,blockchain. Blockchain MCP tools fail closed
# unless this contains blockchain.
TARGET_SURFACES=

TARGET_ECOSYSTEM=
TARGET_CHAIN=
TARGET_CHAIN_ID=
TARGET_NETWORK=
TARGET_RPC_LABEL=

# Comma-separated exact scope values for blockchain tools. Keep
# IN_SCOPE_WEB_TARGETS empty to retain IN_SCOPE_TARGETS compatibility.
IN_SCOPE_CONTRACTS=
IN_SCOPE_REPOS=
IN_SCOPE_CHAIN_IDS=
IN_SCOPE_BLOCK_RANGES=
IN_SCOPE_RPC_ENDPOINTS=
IN_SCOPE_WEB_TARGETS=

ALLOW_MAINNET_TX=false
ALLOW_TESTNET_TX=false
ALLOW_LOCAL_FORK_MUTATION=true
ALLOW_FUZZING=true
ALLOW_INVARIANT_TESTING=true
ALLOW_LIVE_MEV_TESTING=false
ALLOW_LIVE_ORACLE_MANIPULATION=false
ALLOW_DOS_OR_GAS_GRIEFING=false
MAX_TESTNET_GAS_ETH=

AUTHORIZED_ATTACK_CLASSES=static,local-fork-poc,fuzz,invariant,read-only-onchain
